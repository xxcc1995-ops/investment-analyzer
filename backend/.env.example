# Jisilu.cn AES encryption key (for fund data)
JISILU_AES_KEY=

# Tushare Pro API token
TUSHARE_TOKEN=

# FRED API Key (美联储经济数据库 - 免费申请: https://fred.stlouisfed.org/docs/api/api_key.html)
# 未设置时自动回退到AKShare数据源
FRED_API_KEY=

# Polymarket proxy (optional)
# POLYMARKET_PROXY=http://127.0.0.1:7890

# RSSHub instance URL (for financial RSS feeds)
# 公共实例有频率限制，建议自建: docker run -d --name rsshub -p 1200:1200 diygod/rsshub
# RSSHUB_BASE=http://localhost:1200

# QuantDinger AI分析服务 (可选)
# 启动方式: 双击 start-quantdinger.bat
# 默认账号: quantdinger / 123456
# QUANTDINGER_API_URL=http://localhost:8888
# QUANTDINGER_USERNAME=quantdinger
# QUANTDINGER_PASSWORD=123456
